---
import "../styles/global.css";
import { navItems } from "../data/navigation";
import { currentDomain } from "../data/url";

interface Props {
  title: string;
  description?: string;
  activePath?: string;
  handleIdentityCallback?: boolean;
}

const {
  title,
  description,
  activePath = Astro.url.pathname,
  handleIdentityCallback = false,
} = Astro.props;
const identityApiUrl = `https://${currentDomain}/.netlify/identity`;
---

<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    {
      handleIdentityCallback && (
        <script is:inline define:vars={{ identityApiUrl }}>
          const identityCallbackToken =
            /(?:^#|[&#])(invite_token|confirmation_token|recovery_token|email_change_token)=/;
          const isProduction =
            location.hostname !== "localhost" && location.hostname !== "127.0.0.1";

          if (isProduction && identityCallbackToken.test(location.hash)) {
            const widgetScript = document.createElement("script");
            widgetScript.src =
              "https://identity.netlify.com/v1/netlify-identity-widget.js";
            widgetScript.onload = () => {
              if (!window.netlifyIdentity) return;

              const redirectToAdmin = () => location.replace("/admin/");

              window.netlifyIdentity.on("init", (user) => {
                if (user) redirectToAdmin();
              });
              window.netlifyIdentity.on("login", redirectToAdmin);
              window.netlifyIdentity.init({ APIUrl: identityApiUrl });
            };
            document.head.append(widgetScript);
          }
        </script>
      )
    }
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
  </head>

  <body>
    <header class="site-header">
      <a class="logo" href="/" aria-label="Dzieciaki na Miłej — strona główna">
        <img src="/images/legacy/logo-dnm.png" alt="Dzieciaki na Miłej" />
      </a>

      <nav class="main-nav" aria-label="Główna nawigacja">
        {
          navItems.map((item) => (
            <a href={item.href} class={item.href === activePath ? "active" : ""}>
              {item.label}
            </a>
          ))
        }
      </nav>

      <a class="header-cta" href="/kontakt">Umów wizytę</a>
    </header>

    <slot />

    <script>
      const revealElements = document.querySelectorAll(".reveal");

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
            }
          });
        },
        { threshold: 0.16 }
      );

      revealElements.forEach((element) => observer.observe(element));
    </script>
  </body>
</html>

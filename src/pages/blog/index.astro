---
import { getCollection } from "astro:content";
import BlogPage from "../../components/BlogPage.astro";
import {
  getBlogPageUrl,
  paginateBlogPosts,
} from "../../data/blog-pagination";
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/blog.css";

const entries = await getCollection("blog", ({ data }) => data.draft !== true);
const [page] = paginateBlogPosts(entries);
const nextPage =
  page.currentPage < page.totalPages
    ? getBlogPageUrl(page.currentPage + 1)
    : undefined;
---

<BaseLayout
  title="Blog — Dzieciaki na Miłej"
  description="Artykuły Anny i Pawła Strusów o rozwoju dziecka, zdrowiu, logopedii oraz codzienności rodzinnej."
  activePath="/blog"
  nextPage={nextPage}
>
  <BlogPage page={page} />
</BaseLayout>

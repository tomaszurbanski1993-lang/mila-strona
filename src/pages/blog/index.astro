---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import KnowledgeList from "../../components/knowledge/KnowledgeList.astro";
import "../../styles/blog.css";

const entries = await getCollection("blog", ({ data }) => data.draft !== true);
const posts: CollectionEntry<"blog">[] = entries.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
---

<BaseLayout
  title="Blog — Dzieciaki na Miłej"
  description="Artykuły Anny i Pawła Strusów o rozwoju dziecka, zdrowiu, logopedii oraz codzienności rodzinnej."
  activePath="/blog"
>
  <main id="main-content">
    <KnowledgeList
      items={posts}
      eyebrow="Artykuły i materiały"
      title="Blog"
      description="Wiedza specjalistyczna, praktyczne podpowiedzi i teksty z życia Dzieciaków na Miłej — do spokojnego czytania w swoim tempie."
      basePath="/blog"
      emptyText="Nie ma jeszcze opublikowanych wpisów."
      alternateHref="/aktualnosci"
      alternateLabel="Zobacz aktualności"
    />
  </main>
</BaseLayout>

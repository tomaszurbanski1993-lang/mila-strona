---
import { getCollection, render, type CollectionEntry } from "astro:content";
import type { GetStaticPaths } from "astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import KnowledgePost from "../../components/knowledge/KnowledgePost.astro";
import { authors } from "../../data/authors";
import "../../styles/blog.css";

export const getStaticPaths: GetStaticPaths = async () => {
  const entries = await getCollection("blog", ({ data }) => data.draft !== true);
  return entries.map((entry) => ({
    params: { slug: entry.id.replace(/\.[^.]+$/, "") },
    props: { entry },
  }));
};

type Props = { entry: CollectionEntry<"blog"> };

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.description} activePath="/blog">
  <KnowledgePost
    title={entry.data.title}
    description={entry.data.description}
    date={entry.data.date}
    image={entry.data.image}
    tags={entry.data.tags}
    author={entry.data.author ? authors[entry.data.author].name : undefined}
    eyebrow="Z bloga"
    backHref="/blog/"
    backLabel="Wszystkie artykuły"
  >
    <Content />
  </KnowledgePost>
</BaseLayout>

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <base href="/admin/" />
    <title>Content Manager</title>
  </head>
  <body>
    <script is:inline src="https://unpkg.com/decap-cms@3.8.3/dist/decap-cms.js"></script>
    <script is:inline>
      // Only public IDs are persisted in Markdown. user_metadata.author_id on
      // the Identity profile maps the account without putting addresses in the
      // repository or in generated HTML.
      const authorIds = new Set(["anna", "pawel", "anna-i-pawel", "admin"]);

      function authorFromIdentity() {
        const authorId = window.netlifyIdentity?.currentUser?.()?.user_metadata?.author_id;
        return authorIds.has(authorId) ? authorId : undefined;
      }

      window.CMS.registerEventListener({
        name: "preSave",
        handler: ({ entry }) => {
          if (!["blog", "news"].includes(entry.get("collection"))) return entry;

          const existingAuthor = entry.getIn(["data", "author"]);
          if (authorIds.has(existingAuthor)) return entry;

          const authorId = authorFromIdentity();
          return authorId
            ? entry.set("data", entry.get("data").set("author", authorId))
            : entry;
        },
      });
    </script>
    <script is:inline>
      // Decap CMS sam wykrywa lokalny proxy (local_backend: true w config.yml):
      // na localhost łączy się z decap-server (zapis na dysk, bez logowania),
      // a na produkcji używa git-gateway + Netlify Identity. Widget sam
      // inicjalizuje się po załadowaniu skryptu; ponowne init() tworzy drugi
      // iframe i blokuje formularz przyjęcia zaproszenia.
      const isProduction =
        location.hostname !== "localhost" && location.hostname !== "127.0.0.1";
      if (isProduction) {
        const widgetScript = document.createElement("script");
        widgetScript.src =
          "https://identity.netlify.com/v1/netlify-identity-widget.js";
        widgetScript.onload = () => {
          if (!window.netlifyIdentity) return;

          window.netlifyIdentity.on("login", function () {
            document.location.href = "/admin/";
          });
        };
        document.head.append(widgetScript);
      }
    </script>
  </body>
</html>

---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/sections/Hero.astro";
import PracticeCards from "../components/sections/PracticeCards.astro";
import ValuesGrid from "../components/sections/ValuesGrid.astro";
import LatestContent from "../components/sections/LatestContent.astro";
import ContactSection from "../components/sections/ContactSection.astro";
import LocationSection from "../components/sections/LocationSection.astro";
import "../styles/start.css";

const pageTitle = "Dzieciaki na Miłej — logopeda i pediatra w Warce";
const pageDescription =
  "Gabinet logopedyczny Anny Strus i gabinet pediatryczny Pawła Strusa w Warce. Spokojna, specjalistyczna pomoc dla dzieci i ich rodziców.";
---

<BaseLayout title={pageTitle} description={pageDescription} activePath="/">
  <main id="main-content">
    <Hero />
    <PracticeCards />
    <ValuesGrid />
    <LatestContent />
    <ContactSection />
    <LocationSection />
  </main>
</BaseLayout>

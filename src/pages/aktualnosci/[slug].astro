---
import { getCollection, render, type CollectionEntry } from "astro:content";
import type { GetStaticPaths } from "astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import KnowledgePost from "../../components/knowledge/KnowledgePost.astro";
import "../../styles/blog.css";

export const getStaticPaths: GetStaticPaths = async () => {
  const entries = await getCollection("news", ({ data }) => data.draft !== true);
  return entries.map((entry) => ({
    params: { slug: entry.id.replace(/\.[^.]+$/, "") },
    props: { entry },
  }));
};

type Props = { entry: CollectionEntry<"news"> };

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.description} activePath="/aktualnosci">
  <KnowledgePost
    title={entry.data.title}
    description={entry.data.description}
    date={entry.data.date}
    image={entry.data.image}
    tags={entry.data.tags}
    eyebrow="Aktualności"
    backHref="/aktualnosci/"
    backLabel="Wszystkie aktualności"
  >
      <Content />
  </KnowledgePost>
</BaseLayout>

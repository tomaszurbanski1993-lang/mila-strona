---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import KnowledgeList from "../../components/knowledge/KnowledgeList.astro";
import "../../styles/blog.css";

const entries = await getCollection("news", ({ data }) => data.draft !== true);
const items: CollectionEntry<"news">[] = entries.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
---

<BaseLayout
  title="Aktualności — Dzieciaki na Miłej"
  description="Bieżące informacje organizacyjne z gabinetu logopedycznego i pediatrycznego Dzieciaki na Miłej w Warce."
  activePath="/aktualnosci"
>
  <main id="main-content">
    <KnowledgeList
      items={items}
      eyebrow="Z życia gabinetów"
      title="Aktualności"
      description="Zmiany organizacyjne, nowe możliwości w gabinetach i krótkie wiadomości ważne dla naszych pacjentów."
      basePath="/aktualnosci"
      emptyText="Nie ma jeszcze opublikowanych aktualności."
      alternateHref="/blog"
      alternateLabel="Przejdź do bloga"
    />
  </main>
</BaseLayout>

---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "./ui/Container.astro";
import "../styles/legal.css";

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  activePath: string;
  breadcrumbLabel?: string;
  contentLabel?: string;
}

const {
  title,
  description,
  eyebrow,
  activePath,
  breadcrumbLabel = "RODO",
  contentLabel = "Treść klauzuli informacyjnej",
} = Astro.props;
---

<BaseLayout title={`${title} — Dzieciaki na Miłej`} description={description} activePath={activePath}>
  <main id="main-content">
    <section class="legal-hero" aria-labelledby="legal-title">
      <Container>
        <nav class="legal-breadcrumb" aria-label="Okruszki">
          <a href="/">Strona główna</a><span aria-hidden="true">/</span><span>{breadcrumbLabel}</span>
        </nav>
        <p class="eyebrow">{eyebrow}</p>
        <h1 id="legal-title">{title}</h1>
        <p class="lead">{description}</p>
      </Container>
    </section>

    <section class="section legal-content" aria-label={contentLabel}>
      <Container>
        <article class="legal-prose">
          <slot />
        </article>
      </Container>
    </section>
  </main>
</BaseLayout>

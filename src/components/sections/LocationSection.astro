---
import { site } from "../../data/site";
import Container from "../ui/Container.astro";
import Button from "../ui/Button.astro";
import CardIcon from "../ui/CardIcon.astro";
---

<section class="section location-section" aria-labelledby="location-title">
  <Container class="location-layout">
    <div class="location-copy">
      <p class="eyebrow">Dojazd</p>
      <h2 id="location-title">Jak nas znaleźć</h2>
      <address>
        <CardIcon name="location" tone="pink" size="small" />
        <strong>{site.address}</strong>
      </address>
      <Button href={site.mapUrl} variant="secondary">Otwórz trasę w Mapach Google</Button>
    </div>

    <div class="location-map">
      <iframe
        title="Mapa dojazdu do Dzieciaków na Miłej przy ul. Miłej 12 w Warce"
        src="https://www.google.com/maps?q=Mi%C5%82a%2012%2C%2005-660%20Warka&output=embed"
        width="800"
        height="560"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        allowfullscreen
      ></iframe>
    </div>
  </Container>
</section>

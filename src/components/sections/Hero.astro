---
import Container from "../ui/Container.astro";
import Button from "../ui/Button.astro";
---

<section class="home-hero" aria-labelledby="hero-title">
  <span class="hero-orbit hero-orbit--yellow" aria-hidden="true"></span>
  <span class="hero-orbit hero-orbit--pink" aria-hidden="true"></span>

  <Container class="home-hero__grid">
    <div class="home-hero__copy">
      <p class="eyebrow">Gabinet pediatryczny i logopedyczny · Warka</p>
      <h1 id="hero-title">
        Dwa gabinety.<br />Dwie&nbsp;specjalności.
      </h1>
      <p class="home-hero__values" aria-label="Troska, empatia i profesjonalizm">
        <span>Troska</span>
        <span>Empatia</span>
        <span>Profesjonalizm</span>
      </p>
      <p class="lead home-hero__lead">
        Gabinet pediatryczny i logopedyczny w Warce. Łączymy medyczne doświadczenie
        z indywidualnym, pełnym wyrozumiałości podejściem do każdego małego i dużego pacjenta.
      </p>

      <div class="button-row home-hero__actions">
        <Button href="/logopeda">Gabinet logopedyczny <span aria-hidden="true">→</span></Button>
        <Button href="/pediatra" variant="secondary">Gabinet pediatryczny</Button>
      </div>

    </div>

    <div class="home-hero__visual">
      <div class="home-hero__photo-wrap">
        <img
          src="/images/site/anna-pawel-hero.jpg"
          alt="Anna i Paweł Strus, specjaliści Dzieciaków na Miłej"
          width="2000"
          height="1333"
          fetchpriority="high"
        />
      </div>
      <span class="hero-doodle" aria-hidden="true"></span>
    </div>
  </Container>
</section>

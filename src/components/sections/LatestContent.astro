---
import { getCollection } from "astro:content";
import { sortBlogPosts } from "../../data/blog-pagination";
import Container from "../ui/Container.astro";
import Button from "../ui/Button.astro";
import PublicImage from "../PublicImage.astro";

const [blogEntries, newsEntries] = await Promise.all([
  getCollection("blog", ({ data }) => data.draft !== true),
  getCollection("news", ({ data }) => data.draft !== true),
]);
const featuredBlog = sortBlogPosts(blogEntries)[0];
const latestNews = newsEntries
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 2);
const featuredImage = featuredBlog?.data.image?.replace(/^\/public(?=\/)/, "");
const formatDate = (date: Date) =>
  date.toLocaleDateString("pl-PL", { day: "numeric", month: "long", year: "numeric" });
---

<section class="section knowledge-section" aria-labelledby="news-title">
  <Container>
    <div class="section-heading section-heading--split">
      <div>
        <p class="eyebrow">Aktualności</p>
        <h2 id="news-title">Wieści z Miłej</h2>
      </div>
      <p class="lead">
        Bądź na bieżąco z wydarzeniami w naszych gabinetach oraz nowinkami ze świata
        pediatrii i logopedii.
      </p>
    </div>

    <div class="news-stack news-stack--home">
      {
        latestNews.map((item) => (
          <article class="news-card">
            <p class="news-card__meta">Aktualność · <time datetime={item.data.date.toISOString()}>{formatDate(item.data.date)}</time></p>
            <h3><a href={`/aktualnosci/${item.slug}/`}>{item.data.title}</a></h3>
            <p>{item.data.description}</p>
            <a class="text-link" href={`/aktualnosci/${item.slug}/`}>Czytaj dalej</a>
          </article>
        ))
      }
    </div>
    <Button href="/aktualnosci" variant="secondary" class="content-section__all">Wszystkie aktualności</Button>
  </Container>
</section>

<section class="section blog-home-section" aria-labelledby="blog-home-title">
  <Container>
    <div class="section-heading section-heading--split">
      <div>
        <p class="eyebrow">Blog</p>
        <h2 id="blog-home-title">Poza gabinetem. Nasz świat pełen pasji.</h2>
      </div>
      <p class="lead">
        Pomiędzy medycyną a codziennością — wiedza profesjonalna połączona z tym,
        co daje nam energię do działania po godzinach.
      </p>
    </div>

    {featuredBlog && (
      <article class:list={["featured-article", { "featured-article--without-image": !featuredImage }]}>
        {featuredImage && (
          <a
            class:list={["featured-article__media", { "featured-article__media--contain": featuredBlog.data.imageFit === "contain" }]}
            href={`/blog/${featuredBlog.slug}/`}
            tabindex="-1"
            aria-hidden="true"
          >
            <PublicImage
              src={featuredImage}
              alt=""
              loading="lazy"
              sizes="(max-width: 960px) 92vw, 50vw"
            />
          </a>
        )}
        <div class="featured-article__content">
          <p class="eyebrow">Z bloga</p>
          <h3><a href={`/blog/${featuredBlog.slug}/`}>{featuredBlog.data.title}</a></h3>
          <p>{featuredBlog.data.description}</p>
          <time datetime={featuredBlog.data.date.toISOString()}>{formatDate(featuredBlog.data.date)}</time>
          <div class="button-row">
            <Button href={`/blog/${featuredBlog.slug}/`}>Przeczytaj artykuł</Button>
            <Button href="/blog" variant="secondary">Wszystkie artykuły</Button>
          </div>
        </div>
      </article>
    )}
  </Container>
</section>

---
import { featuredBlog, latestNews } from "../../data/home";
import Container from "../ui/Container.astro";
import Button from "../ui/Button.astro";
---

<section class="section knowledge-section" aria-labelledby="knowledge-title">
  <Container>
    <div class="section-heading section-heading--split">
      <div>
        <p class="eyebrow">Wiedza i aktualności</p>
        <h2 id="knowledge-title">Przydatnie dla rodziców</h2>
      </div>
      <p class="lead">
        Artykuły zostają oddzielone od krótkich komunikatów organizacyjnych,
        żeby łatwo znaleźć właściwy rodzaj informacji.
      </p>
    </div>

    <div class="knowledge-grid">
      <article class="featured-article">
        <div class="featured-article__content">
          <p class="eyebrow">{featuredBlog.type}</p>
          <h3>{featuredBlog.title}</h3>
          <p>{featuredBlog.description}</p>
          <time>{featuredBlog.date}</time>
          <Button href={featuredBlog.href} variant="light">Przeczytaj artykuł <span aria-hidden="true">→</span></Button>
        </div>
        <span class="featured-article__shape" aria-hidden="true">Aa</span>
      </article>

      <div class="news-stack">
        {
          latestNews.map((item) => (
            <article class="news-card">
              <p class="news-card__meta">Aktualność · {item.date}</p>
              <h3><a href={item.href}>{item.title}</a></h3>
              <p>{item.description}</p>
              <a class="text-link" href={item.href}>Czytaj dalej <span aria-hidden="true">→</span></a>
            </article>
          ))
        }
        <Button href="/aktualnosci" variant="secondary" class="news-stack__all">Wszystkie aktualności</Button>
      </div>
    </div>
  </Container>
</section>
